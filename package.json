{
  "name": "uid-topup",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/assert-local-db.mjs dev && next dev",
    "build": "node scripts/assert-local-db.mjs build && node scripts/assert-preview-db.mjs && prisma generate && next build",
    "start": "node scripts/assert-local-db.mjs start && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/assert-local-db.mjs db:push && prisma db push",
    "db:migrate": "node scripts/assert-local-db.mjs db:migrate && prisma migrate dev",
    "db:migrate:deploy": "node scripts/assert-local-db.mjs db:migrate:deploy && prisma migrate deploy",
    "db:migrate:status": "node scripts/assert-local-db.mjs db:migrate:status && prisma migrate status",
    "db:seed": "node scripts/assert-local-db.mjs db:seed && tsx prisma/seed.ts",
    "db:studio": "node scripts/assert-local-db.mjs db:studio && prisma studio",
    "db:constraints": "node scripts/assert-local-db.mjs db:constraints && tsx prisma/apply-constraints.ts",
    "db:setup": "node scripts/assert-local-db.mjs db:setup && prisma db push && tsx prisma/seed.ts && tsx prisma/apply-constraints.ts",
    "test:money": "tsx scripts/money-invariants.ts",
    "package:release": "node scripts/package-release.mjs",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test": "node scripts/test-run.mjs",
    "test:coverage": "node scripts/test-run.mjs --coverage",
    "test:flaky": "node scripts/test-flaky.mjs",
    "test:watch": "node scripts/assert-local-db.mjs test && vitest",
    "dev:db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v",
    "dev:db:sync": "node scripts/dev-db-sync.mjs",
    "dev:db:seed": "node scripts/dev-db-seed.mjs",
    "verify:migrate-status": "tsx scripts/verify/migrate-status.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "//overrides": "Next 14.2.35 bundles a nested postcss@8.4.31 vulnerable to sourceMappingURL path-traversal/file-read (GHSA-6g55, GHSA-r28c) and </style> XSS (GHSA-qx2v). Forcing the patched 8.5.x (semver-minor, Next-compatible) closes those without a breaking Next upgrade.",
  "overrides": {
    "postcss": "^8.5.25"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.11.9",
    "next": "^15.5.28",
    "next-auth": "^4.24.10",
    "qrcode": "^1.5.4",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "resend": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.20.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "pg": "^8.22.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.25",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
