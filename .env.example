# ─── Database (Neon / Supabase / Vercel Postgres) ───
DATABASE_URL="postgresql://user:pass@host:5432/uidtopup?sslmode=require"

# ★ Serverless (Vercel) এ deploy করলে — pooled endpoint ব্যবহার করুন
#   (Neon এ হোস্টনামে "-pooler" থাকে) এবং নিচের প্যারামিটার যোগ করুন:
#
#     ...?sslmode=require&connection_limit=1&pool_timeout=20
#
#   কেন: প্রতিটি serverless function নিজের pool বানায়। ডিফল্ট
#   connection_limit (CPU×2+1 ≈ 9) হলে কয়েকটি function একসাথে চললেই
#   Postgres এর সংযোগ-সীমা শেষ হয়ে যায় → "Timed out fetching a new
#   connection from the connection pool" (QA তে বাস্তবে ঘটেছে)।
#   PgBouncer এর পেছনে প্রতি function এ ১টি সংযোগই যথেষ্ট।
#
#   pool_timeout=20 — Neon ঘুম থেকে জাগতে (cold start) সময় দেয়।
#
#   লোকাল ডেভে (একটি দীর্ঘস্থায়ী প্রসেস) এগুলো দরকার নেই —
#   ডিফল্টই ভালো।
#
#   এছাড়া src/lib/prisma.ts এ ক্ষণস্থায়ী সংযোগ-ত্রুটিতে (P2024/P1001)
#   স্বয়ংক্রিয় retry আছে — যেসব ক্ষেত্রে কোয়েরি সার্ভারে পৌঁছায়ইনি।

# ─── Auth ───
# openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_RANDOM_32_BYTES"
NEXTAUTH_URL="http://localhost:3000"

# ─── ছবি আপলোড (Vercel Blob) ───
# Vercel → Storage → আপনার Blob Store → Tokens → Read/Write token কপি করুন।
# মান দেখতে এমন: vercel_blob_rw_XXXXXXXXXXXX_XXXXXXXXXXXXXXXX
#
# ⚠️ প্রোডাকশনে এটি **আবশ্যক**। খালি থাকলে আপলোড স্পষ্টভাবে ব্যর্থ হবে —
#    লোকাল ডিস্কে লেখা হবে **না**। কারণ serverless ফাইল-সিস্টেম ephemeral,
#    তাই ডিস্কে লেখা ব্যানার/স্ক্রিনশট পরের ডিপ্লয়ে নিঃশব্দে হারিয়ে যেত।
#    ডেভে খালি রাখলে সুবিধার জন্য লোকাল ডিস্ক ব্যবহার হয়।
#
# যাচাই করতে: npx tsx scripts/blob-verify.ts
BLOB_READ_WRITE_TOKEN=""

# ─── ইমেইল (Resend) — ঐচ্ছিক ───
# resend.com এ ফ্রি অ্যাকাউন্ট → API key
RESEND_API_KEY=""
EMAIL_FROM="SS UID TOPUP <onboarding@resend.dev>"

# ─── এরর মনিটরিং (Sentry) — ঐচ্ছিক কিন্তু production-এ জোরালোভাবে সুপারিশকৃত ───
# sentry.io → নতুন project (Next.js) → Settings → Client Keys (DSN) → DSN কপি করুন।
# সেট না থাকলে production exception নীরবে হারিয়ে যায় (কোনো ক্র্যাশ রিপোর্ট নেই)।
# Sentry-সামঞ্জস্যপূর্ণ যেকোনো ingest endpoint চলবে (vendor lock-in নেই)।
SENTRY_DSN=""

# ─── ক্রন সুরক্ষা (ঐচ্ছিক) ───
# টেলিগ্রাম scheduler ও অন্যান্য cron endpoint এই সিক্রেট দিয়ে সুরক্ষিত।
# Vercel Cron ব্যবহার করলে সেট করুন; Authorization: Bearer <CRON_SECRET> লাগবে।
CRON_SECRET=""

# ─── Free Fire UID যাচাই (ঐচ্ছিক) ───
# UID lookup API-র কী। না থাকলে double-entry (দুইবার লিখে মিলিয়ে দেখা) fallback চলে।
FF_LOOKUP_API_KEY=""

# ─── গোপন-মান এনক্রিপশন কী (ঐচ্ছিক, সুপারিশকৃত) ───
# টেলিগ্রাম বট টোকেন, 2FA secret ইত্যাদি এনক্রিপ্ট করতে (secretbox/AES-256-GCM)।
# সেট না থাকলে NEXTAUTH_SECRET থেকে HKDF দিয়ে কী বের করা হয় (যথেষ্ট নিরাপদ)।
TELEGRAM_ENC_KEY=""

# ─── স্টোরেজ ড্রাইভার (ঐচ্ছিক) ───
#   ""      — auto: Blob কনফিগার্ড থাকলে Blob; না থাকলে প্রোডাকশনে
#             fail-closed (ডিস্কে লেখে না), ডেভে লোকাল।
#   "blob"  — Vercel Blob বাধ্যতামূলক (সুপারিশকৃত, প্রোডাকশন)
#   "local" — লোকাল ডিস্ক; **কেবল ডেভ/সেল্ফ-হোস্টে**। প্রোডাকশনে দিলে
#             সতর্কবার্তা লগ হয়, কারণ serverless-এ ফাইল হারিয়ে যায়।
#   "s3" / "r2" — S3-সঙ্গতিপূর্ণ (নিচের S3_* মানগুলো লাগবে)
STORAGE_DRIVER="blob"

# ─── টেলিগ্রাম বট (অপারেটর নোটিফিকেশন) — ঐচ্ছিক ───
# নতুন অর্ডার / রিচার্জ / স্টক-সতর্কতা অ্যাডমিনের টেলিগ্রামে পাঠায়।
#
# ১. টেলিগ্রামে @BotFather → /newbot → টোকেন পাবেন → নিচে বসান।
# ২. একটি গ্রুপ/চ্যানেল বানিয়ে বটটিকে সদস্য (চ্যানেল হলে অ্যাডমিন) করুন।
# ৩. সেই গ্রুপে যেকোনো একটি মেসেজ দিন।
# ৪. `npx tsx scripts/telegram-check.ts` চালান — chat_id দেখিয়ে দেবে।
#
# ⚠️ মান অবশ্যই **এক লাইনে** রাখুন। কোটের ভেতরে newline দিলে টোকেনের
#    সাথে '\n' জুড়ে যায় এবং টেলিগ্রাম 404 ফেরত দেয়।
# ⚠️ দুটোই খালি থাকলে ফিচারটি নীরবে বন্ধ থাকে — কোনো ত্রুটি হয় না।
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Seed admin ───
ADMIN_EMAIL="admin@uidtopup.local"
ADMIN_PASSWORD="Admin@2026Secure"   # ⚠️ লাইভে যাওয়ার আগে বদলান!

# ─── Google Login (ঐচ্ছিক) ───
# console.cloud.google.com → OAuth client (Web) → redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── প্রোডাকশন SEO (ঐচ্ছিক কিন্তু প্রস্তাবিত) ──
# sitemap.xml ও robots.txt-এ এই পূর্ণ URL ব্যবহৃত হয়।
# না দিলে NEXTAUTH_URL ব্যবহার হবে।
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ─── প্রক্সি বিশ্বাস (H2) ───
# খালি/অনুপস্থিত (ডিফল্ট, Vercel-এর জন্য সঠিক):
#   `x-forwarded-for` **উপেক্ষা** করা হয়, কারণ যে কেউ সেটি পাঠাতে পারে।
#   কেবল প্ল্যাটফর্ম-নির্ধারিত `x-real-ip` / `cf-connecting-ip` ব্যবহৃত হয়।
# `1` দিলে: সামনে একটি **বিশ্বস্ত** প্রক্সি আছে ধরে নিয়ে `x-forwarded-for`
#   এর বাঁ-দিকের মান ব্যবহার করা হবে।
# ⚠️ প্রক্সি ছাড়া `1` দেবেন না — তাহলে প্রতিটি IP-ভিত্তিক সীমা
#   (লগইন ব্রুট-ফোর্স, forgot, track) হেডার বদলে বাইপাস করা যাবে।
TRUSTED_PROXY=""

# ─── লাইভ আপডেট / SSE (H4) ───
# খালি/অনুপস্থিত (ডিফল্ট, Vercel Hobby-র জন্য সঠিক):
#   `/api/stream` বন্ধ; ক্লায়েন্ট দৃশ্যমানতা-সচেতন ১২০s পোলিং ব্যবহার করে।
#   লুকানো ট্যাব একটিও অনুরোধ পাঠায় না।
# `1` দিলে: প্রকৃত SSE পুশ চালু (নোটিফিকেশন-সংখ্যা ও ব্যালেন্স)।
# ⚠️ কেবল দীর্ঘ-চলমান সার্ভারে (VPS / `next start`) দিন। serverless-এ
#   ফাংশনের আয়ু-সীমা থাকায় সংযোগ বারবার কাটবে ও পুনঃসংযোগ হবে —
#   তখন এটি পোলিং-এর চেয়েও বেশি লোড তৈরি করে।
STREAM_ENABLED=""
