# ─── Database (Neon / Supabase / Vercel Postgres) ───
DATABASE_URL="postgresql://user:pass@host:5432/uidtopup?sslmode=require"

# ─── Auth ───
# openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_RANDOM_32_BYTES"
NEXTAUTH_URL="http://localhost:3000"

# ─── ছবি আপলোড (Vercel Blob) ───
# Vercel → Storage → Create Blob Store → token কপি করুন
# খালি রাখলে upload বন্ধ থাকবে, বাকি সব চলবে
BLOB_READ_WRITE_TOKEN=""

# ─── ইমেইল (Resend) — ঐচ্ছিক ───
# resend.com এ ফ্রি অ্যাকাউন্ট → API key
RESEND_API_KEY=""
EMAIL_FROM="UID TopUp <onboarding@resend.dev>"

# ─── Seed admin ───
ADMIN_EMAIL="admin@uidtopup.local"
ADMIN_PASSWORD="Admin@2026Secure"   # ⚠️ লাইভে যাওয়ার আগে বদলান!

# ─── Google Login (ঐচ্ছিক) ───
# console.cloud.google.com → OAuth client (Web) → redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
