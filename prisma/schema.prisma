generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════ USER ═════════
model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  phone    String  @unique
  password String
  role     Role    @default(USER)
  balance  Decimal @default(0) @db.Decimal(12, 2)
  isBanned Boolean    @default(false)
  status   UserStatus @default(ACTIVE)  // ★ 3-state: ACTIVE/SUSPENDED/BLOCKED

  referralCode      String  @unique
  referredById      String?
  referredBy        User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]  @relation("Referrals")
  referralBonusPaid Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits      Deposit[]
  orders        Order[]
  ledger        LedgerEntry[]
  couponUses    CouponUse[]
  notifications Notification[]

  @@index([createdAt])
  @@index([referredById])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum Role {
  USER
  ADMIN
}

// ═════════ CATALOG ═════════
model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  icon      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String
  slug        String
  image       String?
  description String?
  needsUid    Boolean  @default(true)
  uidLabel    String   @default("Player UID")
  uidHint     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants Variant[]

  @@index([categoryId])
  @@index([isActive])
}

model Variant {
  id        Int      @id @default(autoincrement())
  productId Int
  label     String
  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal  @default(0) @db.Decimal(12, 2)
  oldPrice  Decimal? @db.Decimal(12, 2)
  stock     Int      @default(-1)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  isPopular Boolean  @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([productId])
}

// ═════════ SITE CONTENT ═════════
model Banner {
  id        Int      @id @default(autoincrement())
  image     String
  title     String?
  subtitle  String?
  link      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SocialLink {
  id        Int     @id @default(autoincrement())
  platform  String
  url       String
  label     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

// ═════════ PAYMENT ═════════
model PaymentChannel {
  id          Int       @id @default(autoincrement())
  method      PayMethod
  accountNo   String
  accountType String    @default("Personal")
  instruction String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
}

enum PayMethod {
  BKASH
  NAGAD
  ROCKET
  UPAY
}

// ═════════ COUPON ═════════
model Coupon {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  type         DiscountType
  value        Decimal      @db.Decimal(12, 2)
  minOrder     Decimal      @default(0) @db.Decimal(12, 2)
  maxDiscount  Decimal?     @db.Decimal(12, 2)
  usageLimit   Int?
  usageCount   Int          @default(0)
  perUserLimit Int          @default(1)
  startsAt     DateTime     @default(now())
  expiresAt    DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  uses   CouponUse[]
  orders Order[]

  @@index([code, isActive])
}

enum DiscountType {
  PERCENT
  FIXED
}

model CouponUse {
  id        String   @id @default(cuid())
  couponId  Int
  userId    String
  orderId   String?
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// ═════════ DEPOSIT ═════════
model Deposit {
  id         String        @id @default(cuid())
  depositNo  Int           @unique @default(autoincrement())
  userId     String
  method     PayMethod
  amount     Decimal       @db.Decimal(12, 2)
  trxId      String        @unique
  senderNo   String
  screenshot String?
  status     DepositStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status, createdAt])
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

// ═════════ ORDER ═════════
model Order {
  id          String      @id @default(cuid())
  orderNo     Int         @unique @default(autoincrement())
  userId      String
  variantId   Int
  playerUid   String
  playerName  String?
  subtotal    Decimal     @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  price       Decimal     @db.Decimal(12, 2)
  productName String
  variantName String
  couponId    Int?
  status      OrderStatus @default(PENDING)
  adminNote   String?
  internalNote String?    // ★ শুধু অ্যাডমিন — কাস্টমার দেখে না
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  coupon  Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ═════════ LEDGER ═════════
model LedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  type         LedgerType
  amount       Decimal    @db.Decimal(12, 2)
  balanceAfter Decimal    @db.Decimal(12, 2)
  refId        String?
  note         String?
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

enum LedgerType {
  DEPOSIT
  ORDER
  REFUND
  ADMIN_ADJUST
  REFERRAL_BONUS
}

// ═════════ NOTIFICATION ═════════
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ═════════ SETTINGS ═════════
model Setting {
  key   String @id
  value String
}

// ═════════ ADMIN AUDIT LOG ═════════
// ★ অ্যাডমিন কে কখন কী করল — সব রেকর্ড থাকে।
//   টাকা নিয়ে ঝামেলা হলে এখানে দেখা যাবে কে দায়ী।
model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String   // DEPOSIT_APPROVE, ORDER_COMPLETE, BALANCE_ADJUST...
  targetId  String?  // যে জিনিসে কাজ করল
  amount    Decimal? @db.Decimal(12, 2)
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
}
