{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "acceptEdits",

    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(rm -rf:*)",
      "Bash(rmdir /s:*)",
      "Bash(del /f:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push --force-reset:*)",
      "Bash(npm run db:migrate:deploy:*)",
      "Bash(psql:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(npx vercel:*)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma db push:*)",
      "Edit(prisma/schema.prisma)",
      "Edit(src/lib/auth.ts)",
      "Edit(src/lib/services/wallet.ts)",
      "Edit(src/middleware.ts)",
      "Edit(package.json)"
    ],

    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(prisma/seed.ts)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(*.md)",
      "Write(*.md)",
      "Edit(*.json)",
      "Edit(*.js)",
      "Edit(*.ts)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(public/**)",
      "Write(public/**)",

      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma format:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npx tsx:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git show:*)",

      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(copy:*)",
      "Bash(mv:*)",
      "Bash(move:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(node:*)",
      "Bash(where:*)",
      "Bash(which:*)"
    ]
  }
}
